{
  "name": "@crescendoCat/rule-transform-sdk",
  "version": "0.1.0",
  "description": "Transform SensorRule DynamoDB items to a normalized RuleObject and back.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "dynamodb",
    "rule-engine",
    "sdk",
    "transform"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:crescendoCat/rule-transform-sdk.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
